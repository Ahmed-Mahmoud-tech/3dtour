# Copy this file to .env and fill in the values.
# See README.md for how to get all four — or run `node scripts/get-page-token.mjs <token>`
# once META_APP_ID/META_APP_SECRET are set below, which derives the last two for you.

# From App Dashboard > Settings > Basic. Only needed to mint/refresh a Page token
# (scripts/get-page-token.mjs) — the running MCP server itself never reads these.
META_APP_ID=
META_APP_SECRET=

# The Facebook Page's numeric id (e.g. from get_page_info once the token works, or from
# Page Settings > About > Page transparency).
META_PAGE_ID=

# A Page Access Token derived from a long-lived User Access Token via /me/accounts.
# Effectively non-expiring as long as it isn't revoked. NEVER commit this file.
META_ACCESS_TOKEN=

# The Instagram professional (Business/Creator) account id linked to the Page above.
# scripts/get-page-token.mjs fills this in automatically if the Page has one linked.
META_IG_USER_ID=
